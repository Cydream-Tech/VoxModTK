{
  "compilerOptions": {
    "target": "ES2016",
    "module": "ES2015",
    "outDir": "./out",
    "rootDir": "./Scripts",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": [
      "../../Plugins/Core/Gen/Typing"
    ]
  },
  "include": ["Scripts/**/*.ts"],
  "exclude": ["Scripts/**/*.mjs", "out/**/*"]
}
